# 서버 포트
PORT=3000

# ffmpeg / ffprobe 실행 파일 경로 (시스템 PATH에 있으면 비워두어도 됨)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 동시 실행 제한
MAX_RENDER_CONCURRENCY=2
MAX_ANALYZE_CONCURRENCY=4

# 클라이언트(브라우저)당 동시 진행 중 작업 수 제한
MAX_ACTIVE_JOBS_PER_CLIENT=1

# 렌더링 결과물(mp4) 다운로드 만료 시간 (분)
OUTPUT_EXPIRY_MINUTES=30

# 오래된 작업 정리 주기 (분)
CLEANUP_INTERVAL_MINUTES=5

# URL 분석 타임아웃 (ms)
ANALYZE_TIMEOUT_MS=12000

# 이미지 다운로드 타임아웃 (ms)
IMAGE_TIMEOUT_MS=8000

# 영상 렌더링 타임아웃 (ms)
RENDER_TIMEOUT_MS=300000

# 분석 대상 HTML 최대 크기 (byte)
MAX_HTML_BYTES=3145728

# 이미지 1개 최대 크기 (byte)
MAX_IMAGE_BYTES=8388608

# 사용할 최대 이미지 수
MAX_IMAGES=6

# 렌더 실패 시 자동 재시도 횟수
MAX_RENDER_ATTEMPTS=2
